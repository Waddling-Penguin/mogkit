---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkflowListItem from "../../components/WorkflowListItem.astro";

const workflows = (await getCollection("workflows")).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
);

const wedges = Array.from(new Set(workflows.map((w) => w.data.wedge))).sort();
const tools = Array.from(new Set(workflows.flatMap((w) => w.data.tools))).sort();
const difficulties = ["beginner", "intermediate", "advanced"];
---

<BaseLayout
  title="Workflow Library · mogkit"
  description="A growing, newest-first collection of implementable AI-for-PM workflows. Copy-paste recipes and how-it-works explainers, side by side."
>
  <section class="container-wide py-16">
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <div>
        <p class="font-mono text-xs text-accent-700 mb-2">WORKFLOW LIBRARY</p>
        <h1 class="text-3xl font-semibold tracking-tight text-ink-900">
          Implementable AI-for-PM workflows.
        </h1>
        <p class="mt-3 text-ink-700 max-w-2xl leading-relaxed">
          Each entry is both a copy-paste recipe a PM could ship today and a "how
          it works" explainer that teaches the mechanism. Newest first. We never
          ship a black box.
        </p>
      </div>
      <a href="/rss.xml" class="text-sm text-ink-600 hover:text-accent-700 font-mono">RSS</a>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3 text-sm" id="filters">
      <div class="flex items-center gap-2">
        <label class="text-ink-500">wedge</label>
        <select id="filter-wedge" class="bg-white border border-ink-200 rounded px-2 py-1 text-sm">
          <option value="">all</option>
          {wedges.map((w) => <option value={w}>{w}</option>)}
        </select>
      </div>
      <div class="flex items-center gap-2">
        <label class="text-ink-500">difficulty</label>
        <select id="filter-difficulty" class="bg-white border border-ink-200 rounded px-2 py-1 text-sm">
          <option value="">all</option>
          {difficulties.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>
      <div class="flex items-center gap-2">
        <label class="text-ink-500">tool</label>
        <select id="filter-tool" class="bg-white border border-ink-200 rounded px-2 py-1 text-sm">
          <option value="">all</option>
          {tools.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
      <button id="filter-reset" class="ml-2 text-sm text-ink-500 hover:text-ink-900">reset</button>
      <span id="filter-count" class="ml-auto text-xs text-ink-500"></span>
    </div>

    <div class="mt-6 grid gap-3" id="workflow-list">
      {workflows.map((w) => (
        <div
          class="workflow-card"
          data-wedge={w.data.wedge}
          data-difficulty={w.data.difficulty}
          data-tools={w.data.tools.join("|")}
        >
          <WorkflowListItem
            slug={w.data.slug}
            title={w.data.title}
            outcome={w.data.outcome}
            wedge={w.data.wedge}
            difficulty={w.data.difficulty}
            tools={w.data.tools}
            published={w.data.published}
            timeToImplement={w.data.timeToImplement}
          />
        </div>
      ))}
    </div>

    <p class="mt-12 text-sm text-ink-500">
      Want to contribute? See
      <a href="https://github.com/Waddling-Penguin/mogkit/blob/main/docs/WORKFLOW-FEED-SPEC.md">WORKFLOW-FEED-SPEC.md</a>
      and open a PR with one MDX file.
    </p>
  </section>

  <script is:inline>
    (function() {
      const cards = document.querySelectorAll(".workflow-card");
      const wedgeSel = document.getElementById("filter-wedge");
      const diffSel = document.getElementById("filter-difficulty");
      const toolSel = document.getElementById("filter-tool");
      const countEl = document.getElementById("filter-count");
      const resetBtn = document.getElementById("filter-reset");

      function apply() {
        const w = wedgeSel.value;
        const d = diffSel.value;
        const t = toolSel.value;
        let visible = 0;
        cards.forEach((c) => {
          const matchW = !w || c.dataset.wedge === w;
          const matchD = !d || c.dataset.difficulty === d;
          const matchT = !t || (c.dataset.tools || "").split("|").includes(t);
          const ok = matchW && matchD && matchT;
          c.style.display = ok ? "" : "none";
          if (ok) visible++;
        });
        countEl.textContent = visible + " of " + cards.length;
      }

      [wedgeSel, diffSel, toolSel].forEach((el) => el.addEventListener("change", apply));
      resetBtn.addEventListener("click", () => {
        wedgeSel.value = "";
        diffSel.value = "";
        toolSel.value = "";
        apply();
      });
      apply();
    })();
  </script>
</BaseLayout>
