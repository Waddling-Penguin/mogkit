---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import WorkflowListItem from "../../components/WorkflowListItem.astro";

const workflows = (await getCollection("workflows")).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
);

const wedges = Array.from(new Set(workflows.map((w) => w.data.wedge))).sort();
const tools = Array.from(new Set(workflows.flatMap((w) => w.data.tools))).sort();
const difficulties = ["beginner", "intermediate", "advanced"];
---

<BaseLayout
  title="Workflow Library · mogkit"
  description="A growing, newest-first collection of implementable AI-for-PM workflows. Copy-paste recipes and how-it-works explainers, side by side."
>
  <section class="container-wide pt-16 sm:pt-20 pb-8">
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <div>
        <Eyebrow>Workflow Library</Eyebrow>
        <h1 class="font-display text-4xl sm:text-5xl text-halo tracking-tightest leading-[0.98] mt-4 lift-in lift-in-2">
          Implementable<br/>
          <span class="text-mercury">AI-for-PM workflows.</span>
        </h1>
        <p class="mt-6 text-chrome max-w-2xl leading-relaxed lift-in lift-in-3">
          Each entry is both a copy-paste recipe a PM could ship today and a
          "how it works" explainer that teaches the mechanism. Newest first.
          We never ship a black box.
        </p>
      </div>
      <a href="/rss.xml" class="font-mono text-[12px] uppercase tracking-[0.18em] text-mercury hover:text-halo transition-colors">
        RSS →
      </a>
    </div>

    {/* Filter bar */}
    <div class="mt-10 flex flex-wrap items-center gap-3 text-sm" id="filters">
      <div class="flex items-center gap-2">
        <label class="font-mono text-[11px] uppercase tracking-[0.18em] text-ash">wedge</label>
        <select id="filter-wedge" class="bg-obsidian border border-graphite rounded px-2.5 py-1.5 text-sm text-chrome focus:outline-none focus:border-mercury">
          <option value="">all</option>
          {wedges.map((w) => <option value={w}>{w}</option>)}
        </select>
      </div>
      <div class="flex items-center gap-2">
        <label class="font-mono text-[11px] uppercase tracking-[0.18em] text-ash">difficulty</label>
        <select id="filter-difficulty" class="bg-obsidian border border-graphite rounded px-2.5 py-1.5 text-sm text-chrome focus:outline-none focus:border-mercury">
          <option value="">all</option>
          {difficulties.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>
      <div class="flex items-center gap-2">
        <label class="font-mono text-[11px] uppercase tracking-[0.18em] text-ash">tool</label>
        <select id="filter-tool" class="bg-obsidian border border-graphite rounded px-2.5 py-1.5 text-sm text-chrome focus:outline-none focus:border-mercury">
          <option value="">all</option>
          {tools.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
      <button id="filter-reset" class="ml-2 text-sm text-ash hover:text-chrome transition-colors">reset</button>
      <span id="filter-count" class="ml-auto font-mono text-[11px] uppercase tracking-[0.18em] text-ash"></span>
    </div>
  </section>

  <Section spacing="default">
    <div class="container-wide">
      <div class="grid gap-4" id="workflow-list">
        {workflows.map((w) => (
          <div
            class="workflow-card"
            data-wedge={w.data.wedge}
            data-difficulty={w.data.difficulty}
            data-tools={w.data.tools.join("|")}
          >
            <WorkflowListItem
              slug={w.data.slug}
              title={w.data.title}
              outcome={w.data.outcome}
              wedge={w.data.wedge}
              difficulty={w.data.difficulty}
              tools={w.data.tools}
              published={w.data.published}
              timeToImplement={w.data.timeToImplement}
            />
          </div>
        ))}
      </div>

      <p class="mt-14 text-sm text-ash">
        Want to contribute? See
        <a class="text-mercury hover:text-halo underline decoration-graphite underline-offset-4" href="https://github.com/Waddling-Penguin/mogkit/blob/main/docs/WORKFLOW-FEED-SPEC.md">WORKFLOW-FEED-SPEC.md</a>
        and open a PR with one MDX file.
      </p>
    </div>
  </Section>

  <script is:inline>
    (function () {
      const cards = document.querySelectorAll(".workflow-card");
      const wedgeSel = document.getElementById("filter-wedge");
      const diffSel = document.getElementById("filter-difficulty");
      const toolSel = document.getElementById("filter-tool");
      const countEl = document.getElementById("filter-count");
      const resetBtn = document.getElementById("filter-reset");

      function apply() {
        const w = wedgeSel.value;
        const d = diffSel.value;
        const t = toolSel.value;
        let visible = 0;
        cards.forEach((c) => {
          const matchW = !w || c.dataset.wedge === w;
          const matchD = !d || c.dataset.difficulty === d;
          const matchT = !t || (c.dataset.tools || "").split("|").includes(t);
          const ok = matchW && matchD && matchT;
          c.style.display = ok ? "" : "none";
          if (ok) visible++;
        });
        countEl.textContent = visible + " of " + cards.length;
      }

      [wedgeSel, diffSel, toolSel].forEach((el) => el.addEventListener("change", apply));
      resetBtn.addEventListener("click", () => {
        wedgeSel.value = "";
        diffSel.value = "";
        toolSel.value = "";
        apply();
      });
      apply();
    })();
  </script>
</BaseLayout>
