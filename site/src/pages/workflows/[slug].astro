---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const workflows = await getCollection("workflows");
  return workflows.map((w) => ({
    params: { slug: w.data.slug },
    props: { entry: w },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const dateStr = d.published.toISOString().slice(0, 10);
const updatedStr = d.updated.toISOString().slice(0, 10);
---

<BaseLayout title={`${d.title} · mogkit Workflow Library`} description={d.outcome}>
  <article class="container-tight py-16">
    <p class="font-mono text-xs text-accent-700 mb-2">WORKFLOW LIBRARY · {d.wedge.toUpperCase()}</p>
    <h1 class="text-3xl font-semibold tracking-tight text-ink-900">{d.title}</h1>
    <p class="mt-3 text-ink-700">{d.outcome}</p>

    <div class="mt-5 flex flex-wrap items-center gap-1.5 text-xs">
      <span class="pill-accent">{d.wedge}</span>
      <span class="pill">{d.difficulty}</span>
      <span class="pill">{d.timeToImplement}</span>
      {d.tools.map((t) => <span class="pill">{t}</span>)}
    </div>

    <dl class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm border-y border-ink-200 py-4">
      <div>
        <dt class="text-ink-500 text-xs uppercase tracking-wide">Published</dt>
        <dd class="font-mono text-ink-900 mt-0.5">{dateStr}</dd>
      </div>
      <div>
        <dt class="text-ink-500 text-xs uppercase tracking-wide">Updated</dt>
        <dd class="font-mono text-ink-900 mt-0.5">{updatedStr}</dd>
      </div>
      <div>
        <dt class="text-ink-500 text-xs uppercase tracking-wide">Cost</dt>
        <dd class="text-ink-900 mt-0.5">{d.costNote}</dd>
      </div>
      {d.relatedSkill && (
        <div>
          <dt class="text-ink-500 text-xs uppercase tracking-wide">Related skill</dt>
          <dd class="font-mono text-ink-900 mt-0.5">{d.relatedSkill}</dd>
        </div>
      )}
    </dl>

    <section class="prose prose-ink max-w-none mt-10">
      <Content />
    </section>

    <footer class="mt-16 pt-6 border-t border-ink-200 flex items-baseline justify-between text-sm">
      <a href="/workflows" class="text-ink-600 hover:text-accent-700">← back to the library</a>
      <a href="/rss.xml" class="text-ink-500 font-mono hover:text-accent-700">RSS</a>
    </footer>
  </article>
</BaseLayout>
