---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChromeGlyph from "../components/ChromeGlyph.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="404 · mogkit">
  <section class="container-tight pt-24 sm:pt-32 pb-24 text-center">
    <div class="flex justify-center mb-8 lift-in lift-in-1">
      <ChromeGlyph size={88} />
    </div>
    <p class="eyebrow lift-in lift-in-2">404</p>
    <h1 class="font-display text-4xl sm:text-5xl text-halo tracking-tightest leading-[0.98] mt-4 lift-in lift-in-3">
      This page got mogged<br/>
      <span class="text-mercury">out of existence.</span>
    </h1>
    <p class="mt-6 text-chrome leading-relaxed lift-in lift-in-4">
      It happens. Head back to the homepage or browse the Workflow Library.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3 lift-in lift-in-4">
      <Button href="/" variant="primary">Home</Button>
      <Button href="/workflows" variant="ghost">Workflow Library</Button>
    </div>
  </section>
</BaseLayout>
