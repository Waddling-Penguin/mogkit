---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import WedgeTile from "../../components/WedgeTile.astro";
import { WEDGE_ORDER, WEDGE_META } from "../../lib/wedges";

const wedges = await getCollection("wedges");
const wedgesBySlug = new Map(wedges.map((w) => [w.data.slug, w]));
---

<BaseLayout
  title="Skills · mogkit"
  description="The five areas of product management that mogkit covers: discovery, strategy, planning, go-to-market, and stakeholder conflict."
>
  <section class="container-wide pt-16 sm:pt-20 pb-12">
    <Eyebrow>Skills by area</Eyebrow>
    <h1 class="font-display text-4xl sm:text-5xl text-halo tracking-tightest leading-[0.98] mt-4 lift-in lift-in-2">
      Five areas of PM work.<br/>
      <span class="text-mercury">Pick the one in front of you.</span>
    </h1>
    <p class="mt-6 text-lg text-chrome max-w-2xl leading-relaxed lift-in lift-in-3">
      Each area has a handful of skills. Most take whatever you paste in, such
      as a spec, a launch plan or a pricing idea, and hand back the gaps.
      Discovery goes further. It builds a searchable library from your own
      customer interviews and answers questions with quotes from them.
    </p>
  </section>

  <Section spacing="default">
    <div class="container-wide">
      <div class="grid sm:grid-cols-2 gap-4 stagger">
        {WEDGE_ORDER.map((slug, i) => {
          const entry = wedgesBySlug.get(slug);
          if (!entry) return null;
          return (
            <WedgeTile
              slug={slug}
              title={WEDGE_META[slug].title}
              summary={entry.data.summary}
              engineStatus={entry.data.engineStatus}
              order={i + 1}
            />
          );
        })}
      </div>
    </div>
  </Section>
</BaseLayout>
