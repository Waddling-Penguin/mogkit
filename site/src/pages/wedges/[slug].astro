---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Card from "../../components/Card.astro";
import SkillCard from "../../components/SkillCard.astro";
import { getSkill } from "../../lib/skills";
import { WEDGE_META, type WedgeSlug } from "../../lib/wedges";

export async function getStaticPaths() {
  const wedges = await getCollection("wedges");
  return wedges.map((w) => ({ params: { slug: w.data.slug }, props: { entry: w } }));
}

const { entry } = Astro.props;
const slug = entry.data.slug as WedgeSlug;
const meta = WEDGE_META[slug];
const { Content } = await render(entry);
const skills = entry.data.skills
  .map((name: string) => getSkill(name))
  .filter((s): s is NonNullable<typeof s> => s !== null);
const materialRefs = await Promise.all(
  entry.data.material.map((ref) => getEntry("material", ref.id)),
);
const material = materialRefs.filter((m): m is NonNullable<typeof m> => Boolean(m));
---

<BaseLayout title={`${meta.title} · mogkit`} description={entry.data.summary}>
  <article class="container-tight pt-16 sm:pt-20 pb-8">
    <p class="eyebrow mb-1">Wedge · {String(entry.data.order)}/5</p>
    <h1 class="font-display text-4xl sm:text-5xl text-halo tracking-tightest leading-[0.98] mt-4 lift-in lift-in-2">
      {meta.title}
    </h1>
    <p class="mt-4 text-lg text-mercury leading-relaxed lift-in lift-in-3">
      {meta.subtitle}
    </p>
    <div class="mt-5 lift-in lift-in-4">
      {entry.data.engineStatus === "full" ? (
        <span class="pill-accent">knowledge engine: shipped</span>
      ) : (
        <span class="pill">knowledge engine: coming · standalone skills shipped</span>
      )}
    </div>
  </article>

  <Section spacing="tight" hairline>
    <div class="container-tight">
      <Eyebrow>The problem</Eyebrow>
      <p class="mt-3 text-chrome leading-relaxed text-[17px]">{entry.data.problem}</p>
    </div>
  </Section>

  <Section spacing="default">
    <div class="container-tight prose-voidchrome">
      <Content />
    </div>
  </Section>

  {skills.length > 0 && (
    <Section hairline>
      <div class="container-tight">
        <Eyebrow>Skills to install</Eyebrow>
        <div class="grid sm:grid-cols-2 gap-3 mt-6">
          {skills.map((s) => <SkillCard skill={s} />)}
        </div>
        <p class="mt-5 text-sm text-ash">
          All of these install automatically when you run
          <code class="ml-1">npx mogkit init</code>.
        </p>
      </div>
    </Section>
  )}

  {material.length > 0 && (
    <Section hairline>
      <div class="container-tight">
        <Eyebrow>Material</Eyebrow>
        <p class="mt-2 text-sm text-ash">A curated path. Not a link dump.</p>
        <ul class="mt-6 space-y-3">
          {material.map((m) => (
            <Card padding="md" class="block">
              <div class="flex items-baseline justify-between gap-3">
                <a href={m.data.url} class="font-display text-lg text-halo tracking-tight hover:text-mercury">{m.data.title}</a>
                <span class="pill">{m.data.kind}</span>
              </div>
              <div class="text-sm text-ash mt-1 font-mono uppercase tracking-wider text-[11px]">by {m.data.author}</div>
              <p class="mt-3 text-chrome leading-relaxed">{m.data.why}</p>
            </Card>
          ))}
        </ul>
      </div>
    </Section>
  )}
</BaseLayout>
