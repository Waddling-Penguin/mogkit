---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SkillCard from "../../components/SkillCard.astro";
import { getSkill } from "../../lib/skills";
import { WEDGE_META, type WedgeSlug } from "../../lib/wedges";

export async function getStaticPaths() {
  const wedges = await getCollection("wedges");
  return wedges.map((w) => ({ params: { slug: w.data.slug }, props: { entry: w } }));
}

const { entry } = Astro.props;
const slug = entry.data.slug as WedgeSlug;
const meta = WEDGE_META[slug];
const { Content } = await render(entry);
const skills = entry.data.skills
  .map((name: string) => getSkill(name))
  .filter((s): s is NonNullable<typeof s> => s !== null);
const materialRefs = await Promise.all(
  entry.data.material.map((ref) => getEntry("material", ref.id)),
);
const material = materialRefs.filter((m): m is NonNullable<typeof m> => Boolean(m));
---

<BaseLayout title={`${meta.title} · mogkit`} description={entry.data.summary}>
  <article class="container-tight py-16">
    <p class="font-mono text-xs text-accent-700 mb-2">WEDGE · {String(entry.data.order)}/5</p>
    <h1 class="text-4xl font-semibold tracking-tight text-ink-900">{meta.title}</h1>
    <p class="mt-3 text-lg text-ink-700">{meta.subtitle}</p>

    <div class="mt-4">
      {entry.data.engineStatus === "full" ? (
        <span class="pill-accent">knowledge engine: shipped</span>
      ) : (
        <span class="pill">knowledge engine: coming · standalone skills shipped</span>
      )}
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-ink-900 mb-2">The problem</h2>
      <p class="text-ink-700 leading-relaxed">{entry.data.problem}</p>
    </section>

    <section class="prose prose-ink max-w-none mt-12">
      <Content />
    </section>

    {skills.length > 0 && (
      <section class="mt-16">
        <h2 class="text-xl font-semibold text-ink-900 mb-4">Skills to install</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {skills.map((s) => <SkillCard skill={s} />)}
        </div>
        <p class="mt-4 text-sm text-ink-500">
          All of these install automatically when you run
          <code class="ml-1">npx mogkit init</code>.
        </p>
      </section>
    )}

    {material.length > 0 && (
      <section class="mt-16">
        <h2 class="text-xl font-semibold text-ink-900 mb-4">Material</h2>
        <p class="text-sm text-ink-500 mb-3">A curated path. Not a link dump.</p>
        <ul class="space-y-3">
          {material.map((m) => (
            <li class="rounded-lg border border-ink-200 bg-white p-4">
              <div class="flex items-baseline justify-between gap-3">
                <a href={m.data.url} class="font-semibold text-ink-900">{m.data.title}</a>
                <span class="pill">{m.data.kind}</span>
              </div>
              <div class="text-sm text-ink-500 mt-0.5">by {m.data.author}</div>
              <p class="mt-2 text-sm text-ink-700">{m.data.why}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
