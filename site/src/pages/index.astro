---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import WedgeTile from "../components/WedgeTile.astro";
import WorkflowListItem from "../components/WorkflowListItem.astro";
import SurfboardHeroIsland from "../components/SurfboardHeroIsland.astro";
import ScrollHint from "../components/ScrollHint.astro";
import { WEDGE_ORDER, WEDGE_META } from "../lib/wedges";

const wedges = await getCollection("wedges");
const wedgesBySlug = new Map(wedges.map((w) => [w.data.slug, w]));

const workflows = (await getCollection("workflows")).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
);
const recentWorkflows = workflows.slice(0, 3);
---

<BaseLayout title="mogkit — out-craft the room">

  {/* HERO — chrome surfboard floats BEHIND the headline (Morphic-style).
      Absolute-positioned R3F island fills the section; text overlays it.
      Mobile: shorter section + smaller padding so the content lands above
      the fold without a giant void. */}
  <section class="relative overflow-hidden">
    <div class="relative w-full min-h-[640px] sm:min-h-[82vh]">
      <SurfboardHeroIsland />

      <div class="relative z-10 flex flex-col items-center text-center px-5
                  pt-[8vh] sm:pt-[18vh] pb-24 sm:pb-20">
        <p class="eyebrow lift-in lift-in-1">
          the open-source toolkit for PMs
        </p>
        <h1 class="font-display text-[2.4rem] leading-[1.02] sm:text-6xl md:text-7xl sm:leading-[0.95] text-halo tracking-tightest mt-5 sm:mt-6 max-w-3xl mx-auto lift-in lift-in-2 [text-shadow:0_2px_28px_rgb(10_10_11_/_0.95)]">
          Sharper thinking.<br/>
          <span class="text-mercury">Not just faster output.</span>
        </h1>
        <p class="mt-5 sm:mt-7 text-base sm:text-lg text-chrome max-w-2xl mx-auto leading-relaxed lift-in lift-in-3 [text-shadow:0_1px_16px_rgb(10_10_11_/_0.9)]">
          mogkit installs PM craft into your terminal — a library of
          methodology-backed skills that run in Claude Code, a thin CLI that
          scaffolds your workspace, and a growing library of AI-for-PM workflows
          you can ship today.
        </p>
        <p class="mt-3 text-base sm:text-lg text-chrome max-w-2xl mx-auto leading-relaxed lift-in lift-in-3 [text-shadow:0_1px_16px_rgb(10_10_11_/_0.9)]">
          It won't write your PRD. It'll make you write a better one.
        </p>
        <div class="mt-7 sm:mt-9 flex flex-wrap items-center justify-center gap-3 lift-in lift-in-4">
          <Button href="/setup" variant="primary">Start with Setup 101 →</Button>
          <Button href="/wedges/discovery" variant="ghost">See the Discovery engine</Button>
        </div>
        <p class="mt-6 sm:mt-7 font-mono text-[11px] sm:text-[12px] text-ash tracking-tight lift-in lift-in-4 break-all sm:break-normal">
          $ npx mogkit init my-workspace
        </p>
      </div>

      {/* Scroll hint — pinned to the bottom of the hero, fills the dead
          space below the CTA */}
      <div class="absolute bottom-5 sm:bottom-6 left-1/2 -translate-x-1/2 z-10 lift-in lift-in-4">
        <ScrollHint />
      </div>
    </div>
  </section>

  {/* THE FOUR PILLARS */}
  <Section hairline>
    <div class="container-wide">
      <div class="grid sm:grid-cols-2 gap-y-14 gap-x-16 stagger">
        {[
          {
            eyebrow: "Craft, not output",
            title: "No skill writes the finished deliverable.",
            body: "Every skill produces a reasoning scaffold: what your evidence supports, what you're assuming without proof, what to validate next. You write the doc — and the doc is sharper. We sell judgment, not typing.",
          },
          {
            eyebrow: "Local and yours",
            title: "Runs in your terminal. MIT-licensed.",
            body: "Version-controlled workspace. Your research is an asset you own and grow, not data in someone else's cloud. No SaaS, no login, no lock-in. The CLI never calls a model.",
          },
          {
            eyebrow: "The on-ramp",
            title: "From \"lives in Notion\" to \"works like an engineer.\"",
            body: "Every step is small. Every step earns the next. We don't gatekeep the terminal — we make it approachable. Setup 101 is genuinely followable by someone who has never opened one.",
          },
          {
            eyebrow: "By the craft, for the craft",
            title: "Methodology-backed. Community-built.",
            body: "Continuous discovery, Working Backwards, the real traditions. Skills are plain markdown; workflow entries are MDX; both follow documented specs. The library compounds as PMs contribute to it.",
          },
        ].map((p) => (
          <div>
            <Eyebrow>{p.eyebrow}</Eyebrow>
            <h2 class="font-display text-2xl text-halo tracking-tight mt-3 leading-[1.15]">
              {p.title}
            </h2>
            <p class="mt-3 text-chrome leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  {/* THE FIVE WEDGES */}
  <Section hairline>
    <div class="container-wide">
      <div class="mb-8">
        <Eyebrow>One deep system, many sharp tools</Eyebrow>
        <h2 class="font-display text-3xl text-halo tracking-tight mt-3">
          The five wedges
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-4 stagger">
        {WEDGE_ORDER.map((slug, i) => {
          const entry = wedgesBySlug.get(slug);
          if (!entry) return null;
          return (
            <WedgeTile
              slug={slug}
              title={WEDGE_META[slug].title}
              summary={entry.data.summary}
              engineStatus={entry.data.engineStatus}
              order={i + 1}
            />
          );
        })}
      </div>
    </div>
  </Section>

  {/* WORKFLOW LIBRARY — recent entries */}
  <Section hairline>
    <div class="container-wide">
      <div class="flex items-baseline justify-between mb-3 gap-4">
        <div>
          <Eyebrow>Recipes + mechanism</Eyebrow>
          <h2 class="font-display text-3xl text-halo tracking-tight mt-3">
            Workflow Library
          </h2>
        </div>
        <a href="/workflows" class="text-sm text-mercury hover:text-halo transition-colors">
          browse all →
        </a>
      </div>
      <p class="text-chrome mb-8 max-w-2xl leading-relaxed">
        Implementable AI-for-PM workflows. Each entry is both a copy-paste
        recipe and a "how it works" explainer that teaches the mechanism.
        We never ship a black box.
      </p>
      <div class="grid gap-4 stagger">
        {recentWorkflows.map((w) => (
          <WorkflowListItem
            slug={w.data.slug}
            title={w.data.title}
            outcome={w.data.outcome}
            wedge={w.data.wedge}
            difficulty={w.data.difficulty}
            tools={w.data.tools}
            published={w.data.published}
            timeToImplement={w.data.timeToImplement}
          />
        ))}
      </div>
    </div>
  </Section>

  {/* GET STARTED — the on-ramp. Uses container-wide to align its left
      edge with the wedges + workflow library sections above. */}
  <Section hairline spacing="loose">
    <div class="container-wide">
      <div class="max-w-2xl">
        <Eyebrow>Get started</Eyebrow>
        <h2 class="font-display text-3xl text-halo tracking-tight mt-3">
          Two commands and you're set up.
        </h2>
        <p class="mt-4 text-chrome leading-relaxed">
          If you've used a terminal before, two commands and you're set up. If
          you haven't, Setup 101 walks you through every step from opening the
          terminal to running your first skill.
        </p>
        <pre class="mt-8"><code>$ npm install -g mogkit
$ mogkit init my-workspace
$ cd my-workspace
$ open this folder in Claude Code</code></pre>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/setup" variant="primary">Setup 101 →</Button>
          <Button href="https://github.com/Waddling-Penguin/mogkit" variant="ghost">GitHub</Button>
        </div>
      </div>
    </div>
  </Section>

</BaseLayout>
