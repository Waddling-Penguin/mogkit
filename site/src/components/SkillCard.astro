---
import type { SkillMeta } from "../lib/skills";
import Card from "./Card.astro";
interface Props { skill: SkillMeta }
const { skill } = Astro.props;
const tierLabel = skill.tier === "discovery" ? "discovery engine" : "standalone";
---
<Card padding="sm">
  <div class="flex items-baseline justify-between gap-3 mb-2">
    <h3 class="font-mono text-halo text-sm">{skill.name}</h3>
    <span class="pill">{skill.level}</span>
  </div>
  <div class="flex flex-wrap items-center gap-1.5 mb-3">
    <span class="pill-accent">{tierLabel}</span>
    <span class="pill">{skill.wedge}</span>
  </div>
  <p class="text-sm text-chrome leading-relaxed">{skill.summary}</p>
</Card>
