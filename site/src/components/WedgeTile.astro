---
import Card from "./Card.astro";
interface Props {
  slug: string;
  title: string;
  summary: string;
  engineStatus: "full" | "coming";
  /** Kept for callsite compat; intentionally unused in the layout. */
  order?: number;
}
const { slug, title, summary, engineStatus } = Astro.props;
---
<Card href={`/wedges/${slug}`} padding="md" class="group relative">
  <div class="flex items-start justify-between gap-4 mb-3">
    <h3 class="font-display text-xl text-halo tracking-tight truncate min-w-0">
      {title}
    </h3>
    <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-ash shrink-0 mt-1.5">
      {engineStatus === "full" ? "engine" : "skills"}
    </span>
  </div>
  <p class="text-[15px] text-chrome leading-relaxed pr-6">{summary}</p>
  <span
    class="absolute bottom-4 right-4 font-mono text-mercury text-base
           translate-x-[-6px] opacity-0
           group-hover:translate-x-0 group-hover:opacity-100
           transition-all duration-450 ease-voidchrome"
    aria-hidden="true"
  >→</span>
</Card>
