---
import Card from "./Card.astro";
interface Props {
  slug: string;
  title: string;
  summary: string;
  engineStatus: "full" | "coming";
}
const { slug, title, summary, engineStatus } = Astro.props;
---
<Card href={`/wedges/${slug}`} padding="md" class="group">
  <div class="flex items-baseline justify-between mb-2 gap-3">
    <h3 class="font-display text-lg text-halo tracking-tight">{title}</h3>
    {engineStatus === "full" ? (
      <span class="pill-accent">knowledge engine</span>
    ) : (
      <span class="pill">standalone</span>
    )}
  </div>
  <p class="text-sm text-chrome leading-relaxed">{summary}</p>
</Card>
