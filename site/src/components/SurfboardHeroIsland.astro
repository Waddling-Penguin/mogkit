---
// Voidchrome — lazy mount of the SurfboardHero React island.
// Rendered as an absolutely-positioned background layer. The hero text in
// index.astro overlays it at a higher z-index, Morphic-style.
//
// `client:only="react"` keeps R3F off the server. No SSR placeholder —
// the canvas hydrates fast enough that a placeholder added visual noise.
import SurfboardHero from "./three/SurfboardHero";

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---
<div
  class:list={["absolute inset-0 z-0", cls]}
  aria-hidden="true"
>
  {/* Canvas — needs pointer events so R3F can read cursor position */}
  <SurfboardHero client:only="react" />

  {/* Soft vignette to keep the headline legible against the chrome.
      pointer-events:none so it never intercepts the cursor. */}
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(60% 35% at 50% 58%, rgb(var(--void) / 0.55) 0%, transparent 70%);"
  ></div>
</div>
