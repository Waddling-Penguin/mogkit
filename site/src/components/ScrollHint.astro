---
// Voidchrome — scroll hint.
// Deadpan mono "scroll" with a slow vertical breathe. Sits at the bottom
// of the hero. Reduced-motion: static.
//
// Centering note: letter-spacing in CSS adds trailing whitespace AFTER the
// final character, which shifts a centered word visually left of true
// center. The leading text-indent (equal to the tracking) cancels that
// trail, so the label sits geometrically centered above the arrow.
interface Props {
  /** Optional override label */
  label?: string;
  class?: string;
}
const { label = "scroll", class: cls } = Astro.props;
---
<div
  class:list={[
    "inline-flex flex-col items-center gap-2 text-mercury",
    "scroll-hint",
    cls,
  ]}
  aria-hidden="true"
>
  <span
    class="font-mono text-[10px] uppercase tracking-[0.32em] opacity-70"
    style="text-indent: 0.32em;"
  >
    {label}
  </span>
  <span class="scroll-hint-arrow inline-flex items-center justify-center w-4 h-4">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 2v9.5M3 8l4 4 4-4" />
    </svg>
  </span>
</div>

<style is:global>
  /* Breathe — slow vertical bob + opacity pulse. The arrow drifts down a
     few pixels and fades, suggesting motion without being pushy. */
  .scroll-hint-arrow {
    animation: scrollHintBreathe 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes scrollHintBreathe {
    0%   { transform: translateY(-2px); opacity: 0.45; }
    50%  { transform: translateY(6px);  opacity: 1; }
    100% { transform: translateY(-2px); opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-arrow { animation: none; opacity: 0.7; transform: none; }
  }
</style>
