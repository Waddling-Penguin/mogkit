---
// Voidchrome — header.
// Desktop: full mono nav row, hairline divider.
// Mobile: wordmark + hamburger that opens a full-width dropdown panel.
const nav = [
  { href: "/wedges", label: "Wedges", match: ["/wedges"] },
  { href: "/workflows", label: "Workflow Library", match: ["/workflows"] },
  { href: "/setup", label: "Setup", match: ["/setup"] },
  { href: "/search", label: "Search", match: ["/search"] },
];
const current = Astro.url.pathname;
function isActive(matches: string[]) {
  return matches.some((m) => current === m || current.startsWith(m + "/"));
}
---
<header class="sticky top-0 z-30 border-b border-graphite/70 bg-void/85 backdrop-blur-md">
  <div class="container-wide flex items-center justify-between h-14">
    <a
      href="/"
      class="font-mono font-medium text-base lowercase tracking-tight text-halo hover:text-mercury transition-colors duration-450"
    >
      mogkit
    </a>

    {/* Desktop nav */}
    <nav class="hidden md:flex items-center gap-1 text-[12px] font-mono uppercase tracking-[0.14em]">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "px-2.5 py-1.5 rounded-md transition-colors duration-450 ease-voidchrome",
            isActive(item.match)
              ? "text-mercury"
              : "text-ash hover:text-chrome",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://github.com/Waddling-Penguin/mogkit"
        class="ml-2 px-2.5 py-1.5 rounded-md text-ash hover:text-chrome transition-colors duration-450"
      >
        GitHub
      </a>
    </nav>

    {/* Mobile toggle */}
    <button
      id="nav-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      class="md:hidden -mr-2 p-2 text-ash hover:text-halo transition-colors"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path id="nav-icon-open" d="M4 7h16M4 12h16M4 17h16" />
        <path id="nav-icon-close" d="M6 6l12 12M18 6L6 18" class="hidden" />
      </svg>
    </button>
  </div>

  {/* Mobile dropdown panel */}
  <div
    id="nav-panel"
    class="md:hidden hidden border-t border-graphite/70 bg-void/95 backdrop-blur-md"
  >
    <nav class="container-wide py-3 flex flex-col font-mono text-[13px] uppercase tracking-[0.14em]">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "py-3 border-b border-graphite/60 last:border-b-0 transition-colors",
            isActive(item.match) ? "text-mercury" : "text-ash hover:text-chrome",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://github.com/Waddling-Penguin/mogkit"
        class="py-3 border-t border-graphite/60 text-ash hover:text-chrome transition-colors"
      >
        GitHub →
      </a>
    </nav>
  </div>

  <script is:inline>
    (function () {
      const btn = document.getElementById("nav-toggle");
      const panel = document.getElementById("nav-panel");
      const openIcon = document.getElementById("nav-icon-open");
      const closeIcon = document.getElementById("nav-icon-close");
      if (!btn || !panel) return;
      btn.addEventListener("click", () => {
        const isOpen = !panel.classList.contains("hidden");
        panel.classList.toggle("hidden");
        btn.setAttribute("aria-expanded", String(!isOpen));
        if (openIcon && closeIcon) {
          openIcon.classList.toggle("hidden");
          closeIcon.classList.toggle("hidden");
        }
      });
    })();
  </script>
</header>
