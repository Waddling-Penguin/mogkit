---
// Voidchrome — small static chrome glyph.
// A lozenge with a radial chrome gradient, used as a quiet hero accent on
// detail pages where the full 3D prop would be too much. Pure CSS; no JS,
// no asset weight.
interface Props {
  size?: number;
  class?: string;
}
const { size = 56, class: cls } = Astro.props;
---
<span
  class:list={["inline-block align-middle relative", cls]}
  style={`width:${size}px;height:${size}px;`}
  aria-hidden="true"
>
  <span
    class="absolute inset-0 rounded-full"
    style="background: radial-gradient(circle at 35% 28%, rgb(var(--halo) / 0.95) 0%, rgb(var(--chrome) / 0.7) 22%, rgb(var(--mercury) / 0.55) 48%, rgb(var(--obsidian) / 0.9) 82%, rgb(var(--void)) 100%);"
  ></span>
  <span
    class="absolute inset-0 rounded-full"
    style="background: radial-gradient(ellipse 60% 15% at 50% 18%, rgb(var(--halo) / 0.7) 0%, transparent 60%);"
  ></span>
  <span
    class="absolute -bottom-1 left-1/2 -translate-x-1/2 h-2 w-2/3 rounded-full blur-md"
    style="background: rgb(var(--mercury) / 0.4);"
  ></span>
</span>
