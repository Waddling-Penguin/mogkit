---
// Voidchrome — Section primitive.
// Vertical band with optional hairline top, generous padding, and IO-based
// reveal (`.reveal` set in BaseLayout's script — opacity:0 → 1 on viewport
// entry, un-observed once revealed so sections stay visible).
interface Props {
  /** "default" = py-16 ; "tight" = py-8 ; "loose" = py-24 */
  spacing?: "default" | "tight" | "loose";
  /** Add a hairline divider on top */
  hairline?: boolean;
  revealMode?: "default" | "off";
  class?: string;
  as?: "section" | "div" | "article";
}
const {
  spacing = "default",
  hairline = false,
  revealMode = "default",
  class: cls,
  as: Tag = "section",
} = Astro.props;

const spacingMap: Record<NonNullable<Props["spacing"]>, string> = {
  default: "py-16",
  tight: "py-8",
  loose: "py-24 sm:py-28",
};
const spacingClass = spacingMap[spacing];
---
<Tag
  class:list={[
    "relative",
    spacingClass,
    hairline && "border-t border-graphite/70",
    revealMode === "default" && "reveal",
    cls,
  ]}
  data-revealed={revealMode === "off" ? "true" : "false"}
>
  <slot />
</Tag>
