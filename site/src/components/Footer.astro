---
const year = new Date().getFullYear();
---
<footer class="mt-32 border-t border-graphite/70">
  <div class="container-wide py-12 grid sm:grid-cols-3 gap-10 text-sm">
    <div>
      <div class="flex items-center gap-2.5">
        <img
          src="/logomark-96.png"
          alt="mogkit logomark"
          width="28"
          height="28"
          class="rounded-sm opacity-90"
          loading="lazy"
        />
        <span class="font-mono font-medium text-halo lowercase tracking-tight">mogkit</span>
      </div>
      <p class="text-chrome mt-3 leading-relaxed">
        The open-source toolkit for product managers.
      </p>
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-mercury mt-3">
        discovery-maxxing for product managers
      </p>
    </div>
    <div>
      <div class="font-mono text-[11px] uppercase tracking-[0.22em] text-mercury mb-2">Wedges</div>
      <ul class="space-y-1.5 text-chrome">
        <li><a class="hover:text-halo" href="/wedges/discovery">Discovery</a></li>
        <li><a class="hover:text-halo" href="/wedges/strategy">Strategy</a></li>
        <li><a class="hover:text-halo" href="/wedges/planning">Planning & Roadmapping</a></li>
        <li><a class="hover:text-halo" href="/wedges/gtm">GTM & Launch</a></li>
        <li><a class="hover:text-halo" href="/wedges/conflict">Stakeholder & Conflict</a></li>
      </ul>
    </div>
    <div>
      <div class="font-mono text-[11px] uppercase tracking-[0.22em] text-mercury mb-2">Project</div>
      <ul class="space-y-1.5 text-chrome">
        <li><a class="hover:text-halo" href="/workflows">Workflow Library</a></li>
        <li><a class="hover:text-halo" href="/rss.xml">RSS</a></li>
        <li><a class="hover:text-halo" href="/setup">Setup 101</a></li>
        <li><a class="hover:text-halo" href="/credits">Credits</a></li>
        <li><a class="hover:text-halo" href="https://github.com/Waddling-Penguin/mogkit">GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-graphite/70 py-5">
    <div class="container-wide flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.22em] text-ash">
      <span>© {year} mogkit · MIT</span>
      <span class="text-mercury">out-craft the room.</span>
    </div>
  </div>
</footer>
